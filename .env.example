MONGODB_URI=mongodb://127.0.0.1:27017/hospital_superadmin
MONGODB_DB_NAME=hospital_superadmin
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
HOSPITAL_JWT_SECRET=replace-with-a-separate-long-random-secret
HOSPITAL_JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4028
ALLOWED_ORIGINS=http://localhost:4028,http://localhost:3001,http://localhost:3000
# Use "none" only in production when the frontend and API use different HTTPS sites.
HOSPITAL_COOKIE_SAME_SITE=lax

SUPERADMIN_NAME=Platform Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=StrongPassword123
